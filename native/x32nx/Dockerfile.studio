FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends     build-essential     cmake     git     curl     libopencv-dev     libprotobuf-dev     protobuf-compiler     libssl-dev     libgtest-dev     python3     python3-pip     python3-dev     ffmpeg     blender     ca-certificates     && rm -rf /var/lib/apt/lists/*

RUN pip3 install --break-system-packages     numpy     mistralai

WORKDIR /opt/vision_ia

COPY . .

RUN cmake -S . -B build -DCMAKE_BUILD_TYPE=Release     && cmake --build build --parallel     && ctest --test-dir build --output-on-failure

EXPOSE 8001/udp

CMD ["bash", "scripts/vision_ia_master.sh"]
